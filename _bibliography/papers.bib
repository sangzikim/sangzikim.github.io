@article{xue2026personalvcl,
  title={Personal Visual Context Learning in Large Multimodal Models},
  author={Xue, Zihui and Baid, Ami and Kim, Sangho and Luo, Mi and Grauman, Kristen},
  abbr={arXiv},
  journal={arXiv},
  year={2026},
  eprint={2605.10936},
  archivePrefix={arXiv},
  primaryClass={cs.CV},
  abstract={We introduce Personal Visual Context Learning (Personal VCL), a capability enabling Large Multimodal Models to reason over visual information unique to the user when integrated into wearable devices like smart glasses. We present Personal-VCL-Bench, a benchmark with 2,255 context-query instances across 7 tasks examining three dimensions of a user's visual world: persons, objects, and behavior. Testing seven frontier LMMs reveals a modality paradox (language summaries outperform raw pixels) and a scaling paradox (more historical context frequently fails to improve accuracy). To address these gaps, we propose the Agentic Context Bank, a model-agnostic baseline that organizes visual history into structured, evidence-linked memory and selectively grounds only relevant entries at inference time.},
  html={https://arxiv.org/abs/2605.10936},
  website={https://vision.cs.utexas.edu/projects/PersonalVCL/},
  preview={personal_vcl_teaser.png},
  selected={true}
}

@article{kim2027mmsi4d,
  title={Understanding Multimodal Social Interaction Beyond the Image Plane},
  author={Kim, Sangho and Pavlakos, Georgios},
  journal={Coming soon on arXiv!},
  year={2027},
  hide_year={true},
  abstract={Understanding social interactions requires interpreting not only what people say but also how they behave toward one another. Particularly in multi-party conversations, this becomes highly complex, requiring a holistic understanding of the speaker's spatial and social relationships with surrounding participants. However, conventional approaches relying on 2D representations often struggle to interpret the speaker's nonverbal cues, such as gaze and gestures, which are directional and thus depend on the participants' spatial arrangement. We therefore introduce MMSI4D, the first social referent reasoning approach that explicitly encodes the speaker's 4D motion and 3D relationships with each participant. Leveraging off-the-shelf human mesh recovery, our model represents each of these relationships as a distinct token, allowing it to connect the speaker's cues to each candidate. On two social referent reasoning tasks of the MMSI benchmark, MMSI4D more than doubles the gain of the prior 2D keypoint-based approach over language-only models and outperforms recent zero-shot video large multimodal models. Controlled comparisons demonstrate that 3D representations consistently improve accuracy over their 2D projections across architectures, underscoring the value of reasoning explicitly in 3D. Our analysis further shows that the benefit of 3D grows as participants appearing close in the image lie at increasingly different distances from the camera, highlighting the 3D arrangement as key to resolving the ambiguities inherent in multi-party interactions.},
  html={_CVPR_2027__Understanding_Multimodal_Social_Interaction_Beyond_the_Image_Plane_Arxiv.pdf},
  preview={mmsi4d_teaser.png},
  selected={true}
}
