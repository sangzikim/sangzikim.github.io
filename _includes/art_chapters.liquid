<nav class="art-chapters" aria-label="Art page chapters">
  <div class="art-chapters-inner">
    <a href="#chapter-botanical" class="art-chip is-active" data-target="chapter-botanical">
      <i class="fa-solid fa-seedling" aria-hidden="true"></i>
      <span>Botanical Illustration</span>
    </a>
    <a href="#chapter-museums" class="art-chip" data-target="chapter-museums">
      <i class="fa-solid fa-landmark-dome" aria-hidden="true"></i>
      <span>Galleries &amp; Museums</span>
    </a>
  </div>
</nav>

<style>
  /* ============================================================
     Art page chapter switcher — a sticky pair of paper "bookmark"
     tabs that jump to each chapter. Matches the field-notebook
     palette used by both chapters below.
     ============================================================ */
  html { scroll-behavior: smooth; }

  .art-chapters {
    position: sticky;
    top: 56px;                 /* clears the fixed site navbar */
    z-index: 40;
    display: flex;
    justify-content: center;
    margin: 0 auto 1.6rem;
    padding: 0.5rem 0;
    /* fade the page through behind the floating tabs */
    background: linear-gradient(var(--global-bg-color, #fff) 62%, transparent);
  }
  .art-chapters-inner {
    display: inline-flex;
    gap: 0.3rem;
    padding: 0.32rem;
    background: #f6f1e4;
    border: 1px solid rgba(52, 48, 42, 0.16);
    border-radius: 999px;
    box-shadow: 0 10px 26px -16px rgba(43, 37, 26, 0.5);
    font-family: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
  }
  .art-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    color: #6f6656;
    text-decoration: none;
    font-size: 0.92rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: background 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
  }
  .art-chip i { font-size: 0.82rem; color: #5f6b4a; transition: color 0.3s ease; }
  .art-chip:hover { color: #34302a; background: rgba(52, 48, 42, 0.06); }
  .art-chip.is-active {
    background: #fffdf7;
    color: #34302a;
    box-shadow: 0 1px 0 rgba(255,255,255,0.7) inset, 0 2px 8px -4px rgba(43,37,26,0.4);
  }
  .art-chip.is-active i { color: #b0603a; }

  /* anchor targets sit clear of the site navbar + sticky tab bar */
  #chapter-botanical, #chapter-museums { scroll-margin-top: 116px; }

  @media (max-width: 520px) {
    .art-chip { padding: 0.45rem 0.8rem; font-size: 0.82rem; gap: 0.4rem; }
    .art-chapters { top: 56px; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .art-chip { transition: none; }
  }
</style>

<script>
  (function () {
    // The chapter sections are rendered AFTER this script in the page, so wait
    // for the full DOM before wiring up — otherwise getElementById() returns
    // null, sections is empty, and the click handlers never attach.
    function init() {
    var chips = Array.prototype.slice.call(document.querySelectorAll('.art-chip'));
    var sections = chips
      .map(function (c) { return document.getElementById(c.dataset.target); })
      .filter(Boolean);
    if (!sections.length) return;

    function activate(id) {
      chips.forEach(function (c) { c.classList.toggle('is-active', c.dataset.target === id); });
    }

    var LINE = 140; // px from viewport top (site navbar + sticky tab bar)

    // Instant feedback on click, and hold that state while the smooth scroll
    // is in flight so the scroll-spy below doesn't flip it back mid-animation.
    var lockId = null, lockUntil = 0;
    chips.forEach(function (c) {
      c.addEventListener('click', function () {
        lockId = c.dataset.target;
        lockUntil = Date.now() + 1500; // safety cap if the target is never reached
        activate(lockId);
      });
    });

    // Scroll-spy: the active chapter is the last one whose top has passed a
    // reference line just below the sticky tab bar. Position-based, so it stays
    // reliable even though each chapter is very tall.
    function onScroll() {
      if (lockId) {
        var t = document.getElementById(lockId).getBoundingClientRect().top;
        if (Math.abs(t - LINE) < 90 || Date.now() > lockUntil) {
          lockId = null; // arrived (or timed out) — resume live tracking
        } else {
          return; // still scrolling to the clicked chapter; keep it active
        }
      }
      var current = sections[0].id;
      for (var i = 0; i < sections.length; i++) {
        if (sections[i].getBoundingClientRect().top - LINE <= 0) current = sections[i].id;
      }
      // snap to the last chapter once the page is scrolled to the very bottom
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
        current = sections[sections.length - 1].id;
      }
      activate(current);
    }

    var ticking = false;
    window.addEventListener('scroll', function () {
      if (!ticking) {
        window.requestAnimationFrame(function () { onScroll(); ticking = false; });
        ticking = true;
      }
    }, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    onScroll();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
